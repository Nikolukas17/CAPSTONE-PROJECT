<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Datos locales y salidas de la simulación: no forman parte del proyecto ni se copian al compilar. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);App_Data/**;simulacion-salida/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Data/ImportacionExcel.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Data/PlanificacionPregrado.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
