@model OfertaAcademica.Web.ViewModels.Profesores.ProfesoresIndexViewModel
@{
    ViewData["Title"] = "Profesores";
    @if (TempData["Mensaje"] is string msg) { <div class="alerta alerta--ok" role="status">@msg</div> }
    @if (TempData["Exito"] is string ok) { <div class="alerta alerta--ok" role="status">@ok</div> }
}

<h1 class="titulo-pagina">Profesores</h1>

<div class="barra">
    <form method="get" class="buscador" role="search">
        <i class="bi bi-search"></i>
        <input type="search" name="q" value="@Model.Busqueda" placeholder="Buscar por profesor..." aria-label="Buscar por profesor" />
    </form>
    <a asp-action="Crear" class="btn btn--primario"><i class="bi bi-plus-lg"></i> Nuevo profesor</a>
</div>

<div class="card">
    <table class="tabla">
        <thead>
            <tr>
                <th>NOMBRE</th>
                <th>CORREO ELECTRÓNICO</th>
                <th>TIPO</th>
                <th class="col-acciones">ACCIONES</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model.Items)
        {
            <tr>
                <td>
                    <div class="persona">
                        <span class="avatar">
                            @if (!string.IsNullOrEmpty(p.FotoUrl)) { <img src="@p.FotoUrl" alt="" /> }
                            else { <i class="bi bi-person"></i> }
                        </span>
                        @p.Nombre
                    </div>
                </td>
                <td><a href="mailto:@p.Correo">@p.Correo</a></td>
                <td>@p.Tipo</td>
                <td class="col-acciones">
                    <span class="acciones">
                        <a asp-action="Detalle" asp-route-id="@p.Id" aria-label="Ver @p.Nombre" title="Ver"><i class="bi bi-eye"></i></a>
                        <a asp-action="Editar" asp-route-id="@p.Id" aria-label="Editar @p.Nombre" title="Editar"><i class="bi bi-pencil-square"></i></a>
                        <a asp-action="Detalle" asp-route-id="@p.Id" asp-route-inactivar="true" aria-label="Inactivar @p.Nombre" title="Inactivar"><i class="bi bi-trash3"></i></a>
                    </span>
                </td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr><td colspan="4" class="muted" style="text-align:center;padding:32px">No encontramos profesores con esa búsqueda. Prueba con otro nombre o correo.</td></tr>
        }
        </tbody>
    </table>

    <div class="pie-tabla">
        <span>Mostrando @Model.Desde-@Model.Hasta de @Model.Total resultados</span>
        <nav class="paginacion" aria-label="Paginación">
            <a asp-action="Index" asp-route-q="@Model.Busqueda" asp-route-pagina="@(Model.PaginaActual - 1)"
               class="@(Model.PaginaActual <= 1 ? "is-disabled" : "")" aria-label="Anterior"><i class="bi bi-chevron-left"></i></a>
            @for (var i = 1; i <= Model.TotalPaginas; i++)
            {
                <a asp-action="Index" asp-route-q="@Model.Busqueda" asp-route-pagina="@i"
                   class="@(i == Model.PaginaActual ? "is-active" : "")"
                   aria-current="@(i == Model.PaginaActual ? "page" : null)">@i</a>
            }
            <a asp-action="Index" asp-route-q="@Model.Busqueda" asp-route-pagina="@(Model.PaginaActual + 1)"
               class="@(Model.PaginaActual >= Model.TotalPaginas ? "is-disabled" : "")" aria-label="Siguiente"><i class="bi bi-chevron-right"></i></a>
        </nav>
    </div>
</div>
