@using OfertaAcademica.Web.ViewModels.Profesores
@model ProfesorDetalleViewModel
@{
    ViewData["Title"] = Model.Nombre;
}

<nav class="migas" aria-label="Ruta de navegación">
    <a asp-action="Index">Profesores</a>
    <i class="bi bi-chevron-right"></i>
    <span>@Model.Nombre</span>
</nav>

<section class="card perfil">
    <div class="perfil__foto">
        @if (!string.IsNullOrEmpty(Model.FotoUrl)) { <img src="@Model.FotoUrl" alt="Foto de @Model.Nombre" /> }
        else { <i class="bi bi-person"></i> }
    </div>
    <div class="perfil__fila">
        <div>
            <h1>@Model.Nombre</h1>
            <p>Teléfono: @Model.Telefono</p>
            <p>@Model.Tipo</p>
            <p>@Model.Descripcion</p>
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:12px">
            <span class="estado @(Model.Activo ? "" : "estado--inactivo")">@(Model.Activo ? "Activo" : "Inactivo")</span>
            @if (Model.Activo)
            {
                <button type="button" class="btn btn--secundario" data-dialog-open="dlg-inactivar">Inactivar</button>
                <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn--secundario"><i class="bi bi-pencil-square"></i> Editar</a>
            }
        </div>
    </div>
</section>

<section class="card seccion">
    <h2 class="card__titulo">Materias que puede dictar</h2>
    <table class="tabla">
        <thead><tr><th>CÓDIGO</th><th>NIVEL</th><th>MATERIA</th></tr></thead>
        <tbody>
        @foreach (var m in Model.Materias)
        {
            <tr>
                <td class="codigo">@m.Codigo</td>
                <td class="muted">@(string.IsNullOrEmpty(m.Nivel) ? "N/A" : m.Nivel)</td>
                <td><strong>@m.Materia</strong></td>
            </tr>
        }
        </tbody>
    </table>
</section>

<section class="card seccion">
    <h2 class="card__titulo">Disponibilidad semanal</h2>
    <div class="estado-disp">
        @if (!Model.TieneDisponibilidad)
        {
            <div class="alerta" role="status"><i class="bi bi-exclamation-triangle"></i> Sin disponibilidad registrada: el generador no le asignará cursos.</div>
        }
        else if (Model.DisponibilidadActualizadaUtc is DateTime actualizada)
        {
            <span class="muted">Última actualización: @actualizada.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
        }
        @if (Model.EnlaceDisponibilidadVenceUtc is DateTime vence)
        {
            <span class="muted">· Enlace personal vigente hasta el @vence.ToLocalTime().ToString("dd/MM/yyyy")</span>
        }
    </div>
    @if (Model.Activo)
    {
        <form asp-action="EnlaceDisponibilidad" asp-route-id="@Model.Id" method="post" style="margin-bottom:14px">
            <button type="submit" class="btn btn--secundario"><i class="bi bi-envelope"></i> @(Model.EnlaceDisponibilidadVenceUtc is null ? "Enviar enlace para que registre su disponibilidad" : "Generar y enviar un enlace nuevo")</button>
            <small class="muted">@(Model.EsCatedra ? "Recomendado para profesores de cátedra." : "") El enlace dura 14 días y no requiere cuenta.</small>
        </form>
        @if (TempData["EnlaceDisponibilidad"] is string enlace)
        {
            <div class="enlace-copiar">
                <input type="text" id="enlaceDisp" value="@enlace" readonly aria-label="Enlace de disponibilidad" />
                <button type="button" class="btn btn--secundario btn--sm" onclick="navigator.clipboard.writeText(document.getElementById('enlaceDisp').value).then(() => this.textContent = 'Copiado')">Copiar</button>
            </div>
            <p class="nota">Este enlace solo se muestra ahora. Si lo pierdes, genera uno nuevo (el anterior deja de funcionar).</p>
        }
    }
    <div class="disp">
        <div class="disp__grid">
            <div class="celda celda--cab">HORARIO</div>
            @foreach (var d in ProfesorDetalleViewModel.Dias)
            {
                <div class="celda celda--cab">@d.ToUpperInvariant()</div>
            }
            @for (var b = 0; b < OfertaAcademica.Web.Models.Entities.DisponibilidadSemanal.Bloques.Length; b++)
            {
                var primera = b * OfertaAcademica.Web.Models.Entities.DisponibilidadSemanal.FranjasPorBloque;
                <div class="celda celda--cab">@OfertaAcademica.Web.Models.Entities.DisponibilidadSemanal.Bloques[b]</div>
                @for (var d = 0; d < ProfesorDetalleViewModel.Dias.Length; d++)
                {
                    var libres = Enumerable.Range(primera, OfertaAcademica.Web.Models.Entities.DisponibilidadSemanal.FranjasPorBloque)
                        .Count(f => Model.Disponibilidad[f][d]);
                    var (clase, texto) = libres == OfertaAcademica.Web.Models.Entities.DisponibilidadSemanal.FranjasPorBloque ? ("celda--si", "Disponible")
                        : libres > 0 ? ("celda--parcial", "Parcial") : ("", "No disponible");
                    <div class="celda @clase">@texto</div>
                }
            }
        </div>
    </div>
</section>

<dialog id="dlg-inactivar" class="modal" aria-labelledby="dlg-titulo">
    <form asp-action="Inactivar" asp-route-id="@Model.Id" method="post">
        <div class="modal__icono"><i class="bi bi-exclamation"></i></div>
        <h2 id="dlg-titulo">¿Estás seguro de inactivar a<br />@Model.Nombre?</h2>
        <p>El profesor dejará de estar disponible para la asignación de asignaturas en la oferta académica. Sus registros e historial previo se mantendrán guardados.</p>
        <div class="modal__botones">
            <button type="button" class="btn btn--secundario" data-dialog-close>Cancelar</button>
            <button type="submit" class="btn btn--primario">Confirmar</button>
        </div>
    </form>
</dialog>

@section Scripts {
    @if (ViewBag.AbrirInactivar == true)
    {
        <script>document.getElementById('dlg-inactivar')?.showModal();</script>
    }
}
