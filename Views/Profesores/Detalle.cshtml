@using OfertaAcademica.Web.ViewModels.Profesores
@model ProfesorDetalleViewModel
@{
    ViewData["Title"] = Model.Nombre;
}

<nav class="migas" aria-label="Ruta de navegación">
    <a asp-action="Index">Profesores</a>
    <i class="bi bi-chevron-right"></i>
    <span>@Model.Nombre</span>
</nav>

<section class="card perfil">
    <div class="perfil__foto">
        @if (!string.IsNullOrEmpty(Model.FotoUrl)) { <img src="@Model.FotoUrl" alt="Foto de @Model.Nombre" /> }
        else { <i class="bi bi-person"></i> }
    </div>
    <div class="perfil__fila">
        <div>
            <h1>@Model.Nombre</h1>
            <p>Teléfono: @Model.Telefono</p>
            <p>@Model.Tipo</p>
            <p>@Model.Descripcion</p>
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:12px">
            <span class="estado @(Model.Activo ? "" : "estado--inactivo")">@(Model.Activo ? "Activo" : "Inactivo")</span>
            @if (Model.Activo)
            {
                <button type="button" class="btn btn--secundario" data-dialog-open="dlg-inactivar">Inactivar</button>
                <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn--secundario"><i class="bi bi-pencil-square"></i> Editar</a>
            }
        </div>
    </div>
</section>

<section class="card seccion">
    <h2 class="card__titulo">Materias que puede dictar</h2>
    <table class="tabla">
        <thead><tr><th>CÓDIGO</th><th>NIVEL</th><th>MATERIA</th></tr></thead>
        <tbody>
        @foreach (var m in Model.Materias)
        {
            <tr>
                <td class="codigo">@m.Codigo</td>
                <td class="muted">@(string.IsNullOrEmpty(m.Nivel) ? "N/A" : m.Nivel)</td>
                <td><strong>@m.Materia</strong></td>
            </tr>
        }
        </tbody>
    </table>
</section>

<section class="card seccion">
    <h2 class="card__titulo">Disponibilidad semanal</h2>
    <div class="disp">
        <div class="disp__grid">
            <div class="celda celda--cab">HORARIO</div>
            @foreach (var d in ProfesorDetalleViewModel.Dias)
            {
                <div class="celda celda--cab">@d.ToUpperInvariant()</div>
            }
            @for (var f = 0; f < ProfesorDetalleViewModel.Franjas.Length; f++)
            {
                <div class="celda celda--cab">@ProfesorDetalleViewModel.Franjas[f]</div>
                @for (var d = 0; d < ProfesorDetalleViewModel.Dias.Length; d++)
                {
                    var ok = Model.Disponibilidad[f][d];
                    <div class="celda @(ok ? "celda--si" : "")">@(ok ? "Disponible" : "No disponible")</div>
                }
            }
        </div>
    </div>
</section>

<dialog id="dlg-inactivar" class="modal" aria-labelledby="dlg-titulo">
    <form asp-action="Inactivar" asp-route-id="@Model.Id" method="post">
        <div class="modal__icono"><i class="bi bi-exclamation"></i></div>
        <h2 id="dlg-titulo">¿Estás seguro de inactivar a<br />@Model.Nombre?</h2>
        <p>El profesor dejará de estar disponible para la asignación de asignaturas en la oferta académica. Sus registros e historial previo se mantendrán guardados.</p>
        <div class="modal__botones">
            <button type="button" class="btn btn--secundario" data-dialog-close>Cancelar</button>
            <button type="submit" class="btn btn--primario">Confirmar</button>
        </div>
    </form>
</dialog>

@section Scripts {
    @if (ViewBag.AbrirInactivar == true)
    {
        <script>document.getElementById('dlg-inactivar')?.showModal();</script>
    }
}
