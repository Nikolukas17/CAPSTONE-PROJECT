@using OfertaAcademica.Web.ViewModels.Salones
@model SalonListaViewModel
@{
    ViewData["Title"] = "Salones";
    var pag = Model.Paginacion;
    var hayBusqueda = !string.IsNullOrWhiteSpace(pag.Busqueda);
}

<h1 class="titulo-pagina">Salones</h1>

@if (TempData["Exito"] is string ok) { <div class="alerta alerta--ok" role="status">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alerta" role="alert">@err</div> }

<div class="barra">
    <form method="get" asp-action="Index" class="buscador" role="search">
        <i class="bi bi-search"></i>
        <input type="search" name="q" value="@pag.Busqueda" placeholder="Buscar código o nombre del salón..." aria-label="Buscar salones" autocomplete="off" />
    </form>
    <a asp-action="Crear" class="btn btn--primario"><i class="bi bi-plus-lg"></i> Nuevo salón</a>
</div>

<section class="card" aria-label="Listado de salones">
    @if (Model.Items.Count == 0)
    {
        <div class="vacio">
            <h2>No encontramos salones para “@pag.Busqueda”</h2>
            <p>Prueba con el código (por ejemplo L_001) o con parte del nombre.</p>
            <a asp-action="Index" class="btn btn--secundario">Ver todos los salones</a>
        </div>
    }
    else
    {
        <table class="tabla tabla--cat">
            <caption class="sr-only">Salones disponibles</caption>
            <thead>
                <tr>
                    <th scope="col">Código</th>
                    <th scope="col">Nombre</th>
                    <th scope="col">Tipo</th>
                    <th scope="col" class="tc">Equipos</th>
                    <th scope="col" class="tc">Capacidad</th>
                    <th scope="col" class="tc">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Items)
                {
                    <tr>
                        <td><strong>@s.Codigo</strong></td>
                        <td><strong>@s.Nombre</strong></td>
                        <td>@s.Tipo.ToUpperInvariant()</td>
                        <td class="tc">@s.Equipos</td>
                        <td class="tc">@s.Capacidad</td>
                        <td class="tc">
                            <span class="acciones">
                                <a asp-action="Detalle" asp-route-id="@s.Codigo" title="Ver" aria-label="Ver @s.Nombre"><i class="bi bi-eye"></i></a>
                                <a asp-action="Editar" asp-route-id="@s.Codigo" title="Editar" aria-label="Editar @s.Nombre"><i class="bi bi-pencil-square"></i></a>
                                <button type="button" title="Inactivar" aria-label="Inactivar @s.Nombre"
                                        data-inactivar data-nombre="@s.Nombre" data-action="@Url.Action("Inactivar", new { id = s.Codigo })"><i class="bi bi-trash"></i></button>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="pie-tabla">
            <span>Mostrando @pag.Desde-@pag.Hasta de @pag.TotalResultados resultados</span>
            <partial name="_Paginacion" model="pag" />
        </div>
    }
</section>

<dialog id="modalInactivar" class="modal" aria-labelledby="tituloInactivar">
    <form id="formInactivar" method="post" asp-action="Inactivar" asp-route-id="0">
        <div class="modal__icono"><i class="bi bi-exclamation-lg"></i></div>
        <h2 id="tituloInactivar">¿Inactivar <span data-modal-nombre>este salón</span>?</h2>
        <p>Dejará de estar disponible para programar la oferta académica. Su información y su historial se conservan.</p>
        <div class="modal__botones">
            <button type="button" class="btn btn--secundario" data-cerrar>Cancelar</button>
            <button type="submit" class="btn btn--primario">Sí, inactivar</button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/catalogos.js" asp-append-version="true"></script>
}
