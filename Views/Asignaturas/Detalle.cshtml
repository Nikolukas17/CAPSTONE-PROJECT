@using OfertaAcademica.Web.ViewModels.Asignaturas
@using OfertaAcademica.Web.ViewModels.Shared
@model AsignaturaFormViewModel
@{
    var titulo = Model.EsNueva ? "Nueva asignatura" : Model.Nombre;
    ViewData["Title"] = titulo;
}

<nav class="migas" aria-label="Ruta de navegación">
    <a asp-action="Index">Asignaturas</a>
    <i class="bi bi-chevron-right" aria-hidden="true"></i>
    <span aria-current="page">@titulo.ToUpperInvariant()</span>
</nav>

@if (TempData["Exito"] is string ok) { <div class="alerta alerta--ok" role="status">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alerta" role="alert">@err</div> }

<form asp-action="Guardar" method="post" id="formAsignatura" class="form-asig" data-modo="@(Model.ModoEdicion ? "editar" : "ver")">
    <input type="hidden" asp-for="Id" />

    <div class="cabecera-detalle">
        <h1 class="titulo-pagina">@titulo</h1>
        <div class="fila-botones">
            <button type="button" class="btn btn--secundario solo-lectura" data-accion="editar"><i class="bi bi-pencil-square"></i> Editar</button>
            @if (Model.EsNueva)
            {
                <a asp-action="Index" class="btn btn--secundario solo-edicion">Cancelar</a>
            }
            else
            {
                <a asp-action="Detalle" asp-route-id="@Model.Id" class="btn btn--secundario solo-edicion">Cancelar</a>
            }
            <button type="submit" class="btn btn--primario solo-edicion"><i class="bi bi-check-lg"></i> @(Model.EsNueva ? "Crear asignatura" : "Guardar cambios")</button>
        </div>
    </div>

    <fieldset class="fieldset-plano" disabled="@(Model.ModoEdicion ? null : "disabled")" data-campos>
        <section class="card seccion" aria-labelledby="tituloDatos">
            <div class="card__cab"><h2 id="tituloDatos">Datos de la asignatura</h2></div>
            <table class="tabla tabla--cat tabla--campos">
                <thead><tr><th scope="col">Campo</th><th scope="col">Valores</th></tr></thead>
                <tbody>
                    <tr>
                        <th scope="row"><label asp-for="Codigo"></label></th>
                        <td>
                            <input asp-for="Codigo" class="input" inputmode="numeric" autocomplete="off" />
                            <span asp-validation-for="Codigo" class="campo__error"></span>
                        </td>
                    </tr>
                    <tr>
                        <th scope="row"><label asp-for="CodigoCompartido"></label></th>
                        <td>
                            <input asp-for="CodigoCompartido" class="input" inputmode="numeric" autocomplete="off" placeholder="Opcional" />
                            <span asp-validation-for="CodigoCompartido" class="campo__error"></span>
                        </td>
                    </tr>
                    <tr>
                        <th scope="row"><label asp-for="Nombre"></label></th>
                        <td>
                            <input asp-for="Nombre" class="input" autocomplete="off" />
                            <span asp-validation-for="Nombre" class="campo__error"></span>
                        </td>
                    </tr>
                    <tr>
                        <th scope="row"><label asp-for="Tipologia"></label></th>
                        <td>
                            <select asp-for="Tipologia" asp-items="Model.Tipologias" class="input"></select>
                            <span asp-validation-for="Tipologia" class="campo__error"></span>
                        </td>
                    </tr>
                    <tr>
                        <th scope="row"><label asp-for="ProgramaCodigo"></label></th>
                        <td>
                            <select asp-for="ProgramaCodigo" asp-items="Model.Programas" class="input">
                                <option value="">Selecciona un programa</option>
                            </select>
                            <span asp-validation-for="ProgramaCodigo" class="campo__error"></span>
                        </td>
                    </tr>
                    <tr>
                        <th scope="row"><label asp-for="Creditos"></label></th>
                        <td>
                            <div class="stepper" data-stepper>
                                <input asp-for="Creditos" type="number" min="1" max="12" inputmode="numeric" />
                                <button type="button" data-paso="-1" aria-label="Restar un crédito"><i class="bi bi-dash"></i></button>
                                <button type="button" data-paso="1" aria-label="Sumar un crédito"><i class="bi bi-plus"></i></button>
                            </div>
                            <div><span asp-validation-for="Creditos" class="campo__error"></span></div>
                        </td>
                    </tr>
                    <tr>
                        <th scope="row"><label asp-for="IntensidadHoraria"></label></th>
                        <td>
                            <div class="stepper" data-stepper>
                                <input asp-for="IntensidadHoraria" type="number" min="1" max="20" inputmode="numeric" />
                                <button type="button" data-paso="-1" aria-label="Restar una hora"><i class="bi bi-dash"></i></button>
                                <button type="button" data-paso="1" aria-label="Sumar una hora"><i class="bi bi-plus"></i></button>
                            </div>
                            <div><span asp-validation-for="IntensidadHoraria" class="campo__error"></span></div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </section>

        <section class="card seccion" aria-labelledby="tituloDisp">
            <div class="card__cab">
                <h2 id="tituloDisp">Disponibilidad semanal</h2>
                <div class="leyenda" aria-hidden="true">
                    <span class="l-disp"><i></i>Disponible</span>
                    <span class="l-ocup"><i></i>Ocupado</span>
                    <span class="l-nodisp"><i></i>No disponible</span>
                </div>
            </div>
            <div class="card__cuerpo">
                <partial name="_DisponibilidadGrid" model="new DisponibilidadGridViewModel { NombreCampo = nameof(Model.Disponibilidad), Estados = Model.Disponibilidad, Editable = true }" />
                <p class="nota solo-edicion">Toca una franja para alternarla entre disponible y no disponible. Las franjas ocupadas ya están en la oferta académica y no se pueden cambiar aquí.</p>
            </div>
        </section>
    </fieldset>
</form>

@section Scripts {
    <script src="~/js/catalogos.js" asp-append-version="true"></script>
}
