@using OfertaAcademica.Web.ViewModels.Asignaturas
@model AsignaturaListaViewModel
@{
    ViewData["Title"] = "Asignaturas";
    var pag = Model.Paginacion;
    var hayBusqueda = !string.IsNullOrWhiteSpace(pag.Busqueda);
}

<h1 class="titulo-pagina">Asignaturas</h1>

@if (TempData["Exito"] is string ok) { <div class="alerta alerta--ok" role="status">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alerta" role="alert">@err</div> }

<div class="barra">
    <form method="get" asp-action="Index" class="buscador" role="search">
        <i class="bi bi-search"></i>
        <input type="search" name="q" value="@pag.Busqueda" placeholder="Buscar por código o nombre de asignatura..." aria-label="Buscar asignaturas por código o nombre" autocomplete="off" />
    </form>
    <a asp-action="Nueva" class="btn btn--primario"><i class="bi bi-plus-lg"></i> Nueva asignatura</a>
</div>

<section class="card" aria-label="Listado de asignaturas">
    @if (Model.Items.Count == 0)
    {
        <div class="vacio">
            <h2>@(hayBusqueda ? $"No encontramos asignaturas para “{pag.Busqueda}”" : "Aún no hay asignaturas")</h2>
            <p>@(hayBusqueda ? "Revisa el código o el nombre, o prueba con menos palabras." : "Crea la primera para empezar a armar la oferta académica.")</p>
            @if (hayBusqueda)
            {
                <a asp-action="Index" class="btn btn--secundario">Ver todas las asignaturas</a>
            }
            else
            {
                <a asp-action="Nueva" class="btn btn--primario">Nueva asignatura</a>
            }
        </div>
    }
    else
    {
        <table class="tabla tabla--cat">
            <caption class="sr-only">Asignaturas de la Escuela de Ciencias e Ingeniería</caption>
            <thead>
                <tr>
                    <th scope="col">Código asignatura</th>
                    <th scope="col">Código compartido</th>
                    <th scope="col">Nombre</th>
                    <th scope="col" class="tc">Tipología</th>
                    <th scope="col" class="tc">Créditos</th>
                    <th scope="col" class="tc">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Items)
                {
                    <tr>
                        <td><strong>@a.Codigo</strong></td>
                        <td><strong>@a.CodigoCompartido</strong></td>
                        <td><a asp-action="Detalle" asp-route-id="@a.Id" class="enlace-fila">@a.Nombre</a></td>
                        <td class="tc">@a.Tipologia.ToString().ToUpperInvariant()</td>
                        <td class="tc">@a.Creditos</td>
                        <td class="tc">
                            <span class="acciones">
                                <a asp-action="Detalle" asp-route-id="@a.Id" title="Ver detalle" aria-label="Ver detalle de @a.Nombre"><i class="bi bi-eye"></i></a>
                                <a asp-action="Detalle" asp-route-id="@a.Id" asp-route-editar="true" title="Editar" aria-label="Editar @a.Nombre"><i class="bi bi-pencil-square"></i></a>
                                <button type="button" title="Inactivar" aria-label="Inactivar @a.Nombre"
                                        data-inactivar data-nombre="@a.Nombre" data-action="@Url.Action("Inactivar", new { id = a.Id })"><i class="bi bi-trash"></i></button>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="pie-tabla">
            <span>Mostrando @pag.Desde-@pag.Hasta de @pag.TotalResultados resultados</span>
            <partial name="_Paginacion" model="pag" />
        </div>
    }
</section>

<dialog id="modalInactivar" class="modal" aria-labelledby="tituloInactivar">
    <form id="formInactivar" method="post" asp-action="Inactivar" asp-route-id="0">
        <div class="modal__icono"><i class="bi bi-exclamation-lg"></i></div>
        <h2 id="tituloInactivar">¿Inactivar <span data-modal-nombre>esta asignatura</span>?</h2>
        <p>Dejará de estar disponible para programar la oferta académica. Su información y su historial se conservan.</p>
        <div class="modal__botones">
            <button type="button" class="btn btn--secundario" data-cerrar>Cancelar</button>
            <button type="submit" class="btn btn--primario">Sí, inactivar</button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/catalogos.js" asp-append-version="true"></script>
}
