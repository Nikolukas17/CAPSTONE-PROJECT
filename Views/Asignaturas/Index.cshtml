@model AsignaturaListaViewModel
@using OfertaAcademica.Web.ViewModels.Asignaturas
@{
    ViewData["Title"] = "Asignaturas";
    var pag = Model.Paginacion;
    var hayBusqueda = !string.IsNullOrWhiteSpace(pag.Busqueda);
}

<div class="ur-page">
    <header class="ur-page__head">
        <h1 class="ur-h1">Asignaturas</h1>
        <p class="ur-lead">Catálogo de la Escuela de Ciencias e Ingeniería. Busca una asignatura, revisa su información o edítala antes de armar la oferta del semestre.</p>
    </header>

    <section class="ur-card" aria-label="Listado de asignaturas">
        <div class="ur-toolbar">
            <form method="get" asp-action="Index" class="ur-search" role="search">
                <svg class="ur-icon"><use href="#i-search" /></svg>
                <input type="search" name="q" value="@pag.Busqueda" placeholder="Buscar por código o nombre de asignatura..."
                       aria-label="Buscar asignaturas por código o nombre" autocomplete="off" />
                @if (hayBusqueda)
                {
                    <a asp-action="Index" class="ur-search__clear" aria-label="Limpiar búsqueda">&times;</a>
                }
            </form>
            <a asp-action="Nueva" class="ur-btn ur-btn--primary">
                <svg class="ur-icon"><use href="#i-plus" /></svg> Nueva asignatura
            </a>
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="ur-vacio">
                <h2>@(hayBusqueda ? $"No encontramos asignaturas para “{pag.Busqueda}”" : "Aún no hay asignaturas")</h2>
                <p>@(hayBusqueda ? "Revisa el código o el nombre, o prueba con menos palabras." : "Crea la primera para empezar a armar la oferta académica.")</p>
                @if (hayBusqueda)
                {
                    <a asp-action="Index" class="ur-btn ur-btn--ghost">Ver todas las asignaturas</a>
                }
                else
                {
                    <a asp-action="Nueva" class="ur-btn ur-btn--primary">Nueva asignatura</a>
                }
            </div>
        }
        else
        {
            <div class="ur-table-wrap">
                <table class="ur-table">
                    <caption class="visually-hidden">Asignaturas de la Escuela de Ciencias e Ingeniería</caption>
                    <thead>
                        <tr>
                            <th scope="col">Código asignatura</th>
                            <th scope="col">Código compartido</th>
                            <th scope="col">Nombre</th>
                            <th scope="col">Tipología</th>
                            <th scope="col" class="text-center">Créditos</th>
                            <th scope="col" class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Items)
                        {
                            <tr>
                                <td class="ur-num">@a.Codigo</td>
                                <td class="ur-num">@a.CodigoCompartido</td>
                                <td><a asp-action="Detalle" asp-route-id="@a.Id" class="ur-nombre">@a.Nombre</a></td>
                                <td><span class="ur-badge ur-badge--@a.Tipologia.ToString().ToLowerInvariant()">@a.Tipologia.ToString().ToUpperInvariant()</span></td>
                                <td class="text-center">@a.Creditos</td>
                                <td class="text-end">
                                    <span class="ur-acciones">
                                        <a asp-action="Detalle" asp-route-id="@a.Id" class="ur-icon-btn" title="Ver detalle" aria-label="Ver detalle de @a.Nombre"><svg class="ur-icon"><use href="#i-eye" /></svg></a>
                                        <a asp-action="Detalle" asp-route-id="@a.Id" asp-route-editar="true" class="ur-icon-btn" title="Editar" aria-label="Editar @a.Nombre"><svg class="ur-icon"><use href="#i-pencil" /></svg></a>
                                        <button type="button" class="ur-icon-btn ur-icon-btn--peligro" title="Inactivar" aria-label="Inactivar @a.Nombre"
                                                data-bs-toggle="modal" data-bs-target="#modalInactivar"
                                                data-nombre="@a.Nombre" data-action="@Url.Action("Inactivar", new { id = a.Id })">
                                            <svg class="ur-icon"><use href="#i-trash" /></svg>
                                        </button>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="ur-table-foot">
                <p>Mostrando @pag.Desde–@pag.Hasta de @pag.TotalResultados resultados</p>
                <partial name="_Paginacion" model="pag" />
            </div>
        }
    </section>
</div>

<div class="modal fade ur-modal" id="modalInactivar" tabindex="-1" aria-labelledby="tituloInactivar" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content">
            <form id="formInactivar" method="post" asp-action="Inactivar" asp-route-id="0">
                <div class="modal-body">
                    <div class="ur-modal__icono"><svg class="ur-icon"><use href="#i-alert" /></svg></div>
                    <h2 id="tituloInactivar">¿Inactivar <span data-modal-nombre>esta asignatura</span>?</h2>
                    <p>Dejará de estar disponible para programar la oferta académica. Su información y su historial se conservan.</p>
                    <div class="ur-modal__botones">
                        <button type="button" class="ur-btn ur-btn--ghost" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="ur-btn ur-btn--primary">Sí, inactivar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/asignaturas.js" asp-append-version="true"></script>
}
