@* Atajos para la cuadrícula de disponibilidad. Requiere wwwroot/js/disponibilidad-atajos.js. *@
<div class="atajos-disp" role="group" aria-label="Atajos de disponibilidad">
    <span class="muted">Atajos (se suman a lo marcado):</span>
    <button type="button" class="btn btn--secundario btn--sm" data-preset="mananas">Mañanas L–V (7–13)</button>
    <button type="button" class="btn btn--secundario btn--sm" data-preset="tardes">Tardes L–V (13–17)</button>
    <button type="button" class="btn btn--secundario btn--sm" data-preset="noches">Noches L–V (17–19)</button>
    <button type="button" class="btn btn--secundario btn--sm" data-preset="sabado">Sábado (7–13)</button>
    <button type="button" class="btn btn--secundario btn--sm" data-preset="jornada" data-reemplazar="true">Jornada fija 7–17</button>
    <button type="button" class="btn btn--secundario btn--sm" data-preset="limpiar">Limpiar todo</button>
</div>
