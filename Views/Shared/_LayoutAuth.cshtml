@* Layout de inicio de sesión, registro y recuperación de contraseña. *@
@{ Layout = "_LayoutBase"; }

<main id="contenido" class="ur-auth">
    <aside class="ur-auth__marca" aria-hidden="true">
        <partial name="_Logo" model="true" />
        <p>Una oferta académica clara, sin cruces y lista a tiempo.</p>
    </aside>
    <section class="ur-auth__panel">
        <div class="ur-auth__caja">
            <a asp-controller="Home" asp-action="Index" class="ur-auth__logo" aria-label="Volver al inicio"><partial name="_Logo" model="false" /></a>
            @RenderBody()
        </div>
    </section>
</main>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
