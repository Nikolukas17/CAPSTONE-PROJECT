@{
    var accion = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLowerInvariant();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Sistema de Gestión de Horarios</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="topbar">
        <div class="topbar__inner">
            <a asp-controller="Home" asp-action="Index" class="brand">
                <img src="~/img/logo-rosario.svg" alt="Universidad del Rosario" />
            </a>
            <nav class="nav" aria-label="Principal">
                <a asp-controller="Account" asp-action="Registro" class="nav__link @(accion == "registro" ? "is-active" : "")">Registrarse</a>
                <a asp-controller="Account" asp-action="Login" class="nav__link @(accion == "login" ? "is-active" : "")">Iniciar Sesión</a>
            </nav>
        </div>
    </header>

    <main class="page page--flush">@RenderBody()</main>

    <footer class="footer">
        <div class="footer__inner">
            <div class="footer__brand">
                <img src="~/img/logo-rosario-blanco.svg" alt="Universidad del Rosario" />
                <div>
                    <strong>Sistema de Gestión de Horarios</strong>
                    <span>Escuela de Ciencias e Ingeniería</span>
                </div>
            </div>
            <div class="footer__col">
                <h4>Síguenos</h4>
                <div class="footer__social">
                    <i class="bi bi-facebook"></i><i class="bi bi-twitter"></i><i class="bi bi-instagram"></i>
                </div>
                <span>@@urosario.edu.co</span>
            </div>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

