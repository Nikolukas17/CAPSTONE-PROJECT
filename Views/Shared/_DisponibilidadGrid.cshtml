@using OfertaAcademica.Web.Models.Entities
@using OfertaAcademica.Web.ViewModels.Shared
@model DisponibilidadGridViewModel
@{
    string Etiqueta(string e) => e switch
    {
        nameof(EstadoFranja.Disponible) => "Disponible",
        nameof(EstadoFranja.Ocupado) => "Ocupado",
        "Parcial" => "Parcial",
        _ => "No disponible"
    };
    EstadoFranja EstadoEn(int idx) => idx < Model.Estados.Count ? Model.Estados[idx] : EstadoFranja.NoDisponible;

    // En modo bloques cada fila agrupa 4 franjas de 30 min; si no, cada fila es una franja.
    var porFila = Model.BloquesDosHoras ? DisponibilidadSemanal.FranjasPorBloque : 1;
    var filas = Model.BloquesDosHoras ? DisponibilidadSemanal.Bloques : DisponibilidadSemanal.Franjas;
}
<div class="slots-wrap">
    <table class="slots @(Model.BloquesDosHoras ? "slots--bloques" : "")" @(Model.Editable ? "data-grid-editable" : null)>
        <caption class="sr-only">Disponibilidad semanal por @(Model.BloquesDosHoras ? "bloques de 2 horas" : "franja horaria")</caption>
        <thead>
            <tr>
                <th scope="col">Horario</th>
                @foreach (var dia in DisponibilidadSemanal.Dias)
                {
                    <th scope="col">@dia</th>
                }
            </tr>
        </thead>
        <tbody>
            @for (var fila = 0; fila < filas.Length; fila++)
            {
                var primera = fila * porFila;
                <tr>
                    <th scope="row">@filas[fila]</th>
                    @for (var d = 0; d < DisponibilidadSemanal.Dias.Length; d++)
                    {
                        var estados = Enumerable.Range(primera, porFila).Select(f => EstadoEn(DisponibilidadSemanal.Indice(f, d))).ToList();
                        var estado = estados.Distinct().Count() == 1 ? estados[0].ToString()
                            : estados.Contains(EstadoFranja.Ocupado) ? nameof(EstadoFranja.Ocupado) : "Parcial";
                        var etiqueta = $"{DisponibilidadSemanal.Dias[d]} {filas[fila]}: {Etiqueta(estado)}";
                        <td>
                            @if (Model.Editable)
                            {
                                for (var f = primera; f < primera + porFila; f++)
                                {
                                    var idx = DisponibilidadSemanal.Indice(f, d);
                                    <input type="hidden" name="@($"{Model.NombreCampo}[{idx}]")" value="@EstadoEn(idx)" />
                                }
                            }
                            @if (Model.Editable && estado != nameof(EstadoFranja.Ocupado))
                            {
                                <button type="button" class="slot" data-estado="@estado" aria-label="@etiqueta"
                                        data-dia="@DisponibilidadSemanal.Dias[d]" data-franja="@filas[fila]" data-d="@d" data-f="@primera">@Etiqueta(estado)</button>
                            }
                            else
                            {
                                <span class="slot" data-estado="@estado" role="img" aria-label="@etiqueta">@Etiqueta(estado)</span>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
