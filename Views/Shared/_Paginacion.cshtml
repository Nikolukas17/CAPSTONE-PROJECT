@using OfertaAcademica.Web.ViewModels.Shared
@model PaginacionViewModel
@if (Model.TotalPaginas > 1)
{
    <nav class="ur-pager" aria-label="Paginación">
        @if (Model.Pagina > 1)
        {
            <a class="ur-pager__btn" asp-route-pagina="@(Model.Pagina - 1)" asp-route-q="@Model.Busqueda" aria-label="Página anterior"><svg class="ur-icon"><use href="#i-left" /></svg></a>
        }
        else
        {
            <span class="ur-pager__btn is-disabled" aria-hidden="true"><svg class="ur-icon"><use href="#i-left" /></svg></span>
        }

        @foreach (var p in Model.PaginasVisibles)
        {
            <a class="ur-pager__btn @(p == Model.Pagina ? "is-current" : "")"
               asp-route-pagina="@p" asp-route-q="@Model.Busqueda"
               aria-label="Página @p" aria-current="@(p == Model.Pagina ? "page" : null)">@p</a>
        }

        @if (Model.Pagina < Model.TotalPaginas)
        {
            <a class="ur-pager__btn" asp-route-pagina="@(Model.Pagina + 1)" asp-route-q="@Model.Busqueda" aria-label="Página siguiente"><svg class="ur-icon"><use href="#i-right" /></svg></a>
        }
        else
        {
            <span class="ur-pager__btn is-disabled" aria-hidden="true"><svg class="ur-icon"><use href="#i-right" /></svg></span>
        }
    </nav>
}
