@using OfertaAcademica.Web.ViewModels.Shared
@model PaginacionViewModel
@if (Model.TotalPaginas > 1)
{
    <nav class="paginacion" aria-label="Paginación">
        @if (Model.Pagina > 1)
        {
            <a asp-route-pagina="@(Model.Pagina - 1)" asp-route-q="@Model.Busqueda" aria-label="Página anterior"><i class="bi bi-chevron-left"></i></a>
        }
        else
        {
            <span class="is-disabled" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>
        }

        @foreach (var p in Model.PaginasVisibles)
        {
            <a class="@(p == Model.Pagina ? "is-active" : "")" asp-route-pagina="@p" asp-route-q="@Model.Busqueda"
               aria-label="Página @p" aria-current="@(p == Model.Pagina ? "page" : null)">@p</a>
        }

        @if (Model.Pagina < Model.TotalPaginas)
        {
            <a asp-route-pagina="@(Model.Pagina + 1)" asp-route-q="@Model.Busqueda" aria-label="Página siguiente"><i class="bi bi-chevron-right"></i></a>
        }
        else
        {
            <span class="is-disabled" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
        }
    </nav>
}
