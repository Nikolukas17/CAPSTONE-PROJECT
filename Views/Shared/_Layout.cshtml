@* Layout de la aplicación (usuario con sesión): barra de navegación + contenido + pie. *@
@{ Layout = "_LayoutBase"; }

<partial name="_Navbar" />
<main id="contenido" class="ur-main">
    @RenderBody()
</main>
<partial name="_Footer" />

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
