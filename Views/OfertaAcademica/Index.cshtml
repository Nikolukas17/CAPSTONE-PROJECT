@using System.Globalization
@model OfertaAcademica.Web.ViewModels.Oferta.OfertaAcademicaViewModel
@{
    ViewData["Title"] = "Oferta Académica";
    var es = new CultureInfo("es-CO");
    var dias = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday };
    DateTime Fecha(DayOfWeek d) => Model.InicioSemana.AddDays(((int)d + 6) % 7);
}

<section>
    <h1 class="titulo-pagina">Oferta Académica</h1>

    <div class="card cal-card">
        <header class="cal-head">
            <div>
                <h2>Vista rápida de horarios</h2>
                <p>Semana @Model.Semana - Del @Model.InicioSemana.Day al @Fecha(DayOfWeek.Saturday).ToString("d 'de' MMMM, yyyy", es)</p>
            </div>
            <div class="cal-semana">
                <a class="cal-nav @(Model.Semana <= 1 ? "is-disabled" : "")" asp-action="Index" asp-route-semana="@(Model.Semana - 1)" aria-label="Semana anterior"><i class="bi bi-chevron-left"></i></a>
                <span>Semana @Model.Semana</span>
                <a class="cal-nav @(Model.Semana >= Model.TotalSemanas ? "is-disabled" : "")" asp-action="Index" asp-route-semana="@(Model.Semana + 1)" aria-label="Semana siguiente"><i class="bi bi-chevron-right"></i></a>
            </div>
        </header>

        <div class="cal-scroll">
            <div class="cal">
                <div class="cal-esquina"></div>
                @foreach (var d in dias)
                {
                    <div class="cal-dia"><span>@Fecha(d).ToString("ddd", es)</span><strong>@Fecha(d).Day</strong></div>
                }

                @foreach (var h in Model.Franjas)
                {
                    <div class="cal-hora">@($"{h}:00")</div>
                    @foreach (var d in dias)
                    {
                        var ses = Model.EnFranja(d, h);
                        <div class="cal-celda">
                            @if (ses.Count > 0)
                            {
                                var p = ses[0];
                                <button type="button" class="franja @p.Color"
                                        data-dia="@((int)d)" data-hora="@h" data-fecha="@Fecha(d).ToString("yyyy-MM-dd")">
                                    <strong>@p.Nombre</strong>
                                    <span>@p.Salon</span>
                                    @if (ses.Count > 1)
                                    {
                                        <small>+@(ses.Count - 1) @(ses.Count - 1 == 1 ? "asignatura" : "asignaturas") en esta franja</small>
                                    }
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <footer class="cal-foot"><button type="button" class="btn-link">Generar Excel <i class="bi bi-arrow-right"></i></button></footer>
    </div>
</section>

<!-- Franja horaria: lista de asignaturas -->
<dialog id="dlg-franja" class="dlg dlg--ancho" aria-labelledby="fr-titulo" data-duracion="@Model.DuracionFranja">
    <header class="fr-head">
        <div>
            <small id="fr-fecha" class="fr-fecha"></small>
            <h3 id="fr-titulo"></h3>
            <p id="fr-sub" class="fr-sub"></p>
        </div>
        <button type="button" class="fr-x" data-close aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
    </header>
    <ul id="fr-lista" class="fr-lista"></ul>
    <p class="fr-hint">Selecciona una asignatura para ver su detalle.</p>
</dialog>

<!-- Detalle de asignatura -->
<dialog id="dlg-detalle" class="dlg" aria-labelledby="det-nombre" data-url-detalle="@Url.Action("Detalle", "Asignaturas", new { id = "__ID__" })">
    <header><span id="det-horario" class="chip"></span></header>
    <h3 id="det-nombre"></h3>
    <div class="det-prof"><span id="det-ini" class="det-avatar"></span><div><small>Profesor</small><strong id="det-prof"></strong></div></div>
    <dl class="det-grid">
        <div><dt>Código</dt><dd id="det-cod"></dd></div>
        <div><dt>Cupo</dt><dd id="det-cupo"></dd></div>
        <div><dt>Horario</dt><dd id="det-dia"></dd></div>
        <div><dt>Salón</dt><dd id="det-salon"></dd></div>
        <div><dt>Grupo</dt><dd id="det-grupo"></dd></div>
        <div><dt>Programa</dt><dd id="det-prog"></dd></div>
    </dl>
    <footer class="dlg-pie">
        <button type="button" class="btn btn--secundario" data-close>Cerrar</button>
        <a id="det-link" class="btn btn--primario" href="#">Ver asignatura completa</a>
    </footer>
</dialog>

<script type="application/json" id="oferta-data">@Json.Serialize(Model.Sesiones)</script>
@section Scripts {
    <script src="~/js/oferta-calendario.js" asp-append-version="true"></script>
}
