@model OfertaAcademica.Web.ViewModels.Oferta.OfertaSemanaViewModel
@using OfertaAcademica.Web.Services
@{
    ViewData["Title"] = "Oferta Académica";
    string[] dias = ["Lun", "Mar", "Mié", "Jue", "Vie"];
}

<div class="ur-page">
    <header class="ur-page__head">
        <h1 class="ur-h1">Oferta Académica</h1>
        <p class="ur-lead">Revisa cómo quedó la programación de la semana. Toca una asignatura para ver su detalle o “más asignaturas” para ver todo lo que ocurre en esa franja.</p>
    </header>

    <section class="ur-card" aria-labelledby="tituloVista">
        <div class="ur-cal-bar">
            <div>
                <h2 class="ur-h2" id="tituloVista">Vista rápida de horarios</h2>
                <span class="ur-muted">@Model.Titulo</span>
            </div>
            <button type="button" class="ur-btn ur-btn--outline" data-demo="La exportación a Excel se conectará cuando esté lista la base de datos.">
                <svg class="ur-icon"><use href="#i-download" /></svg> Generar Excel
            </button>
        </div>

        <div class="ur-leyenda" style="padding:.9rem 1.5rem 0" aria-label="Programas">
            <span><i style="background:#fbe9ec;border-color:#c4344d"></i>MACC</span>
            <span><i style="background:#fff3d9;border-color:#d9a021"></i>MA02</span>
            <span><i style="background:#e3f4ea;border-color:#3a9a68"></i>IS01</span>
            <span><i style="background:#e8eefb;border-color:#4f73c4"></i>IM01</span>
        </div>

        <div class="ur-cal-scroll">
            <div class="ur-cal" id="calendario" data-url-detalle="@Url.Action("Detalle", "Asignaturas")">
                <div></div>
                @for (var d = 0; d < dias.Length; d++)
                {
                    <div class="ur-cal__dia">@dias[d]<small>@Model.NumerosDia[d]</small></div>
                }

                @foreach (var hora in Model.Horas)
                {
                    <div class="ur-cal__hora">@($"{hora}:00")</div>
                    @for (var d = 0; d < dias.Length; d++)
                    {
                        var enFranja = Model.Clases.Where(c => c.Dia == d && c.Hora == hora).ToList();
                        <div class="ur-cal__celda">
                            @if (enFranja.Count > 0)
                            {
                                var principal = enFranja[0];
                                var indice = Model.Clases.IndexOf(principal);
                                <div class="ur-clase ur-clase--@principal.Programa">
                                    <button type="button" class="ur-clase__nombre" data-clase="@indice">@principal.Nombre</button>
                                    <span class="ur-clase__salon">@principal.Salon</span>
                                    @if (enFranja.Count > 1)
                                    {
                                        <button type="button" class="ur-clase__mas" data-franja-dia="@d" data-franja-hora="@hora">
                                            +@(enFranja.Count - 1) asignatura@(enFranja.Count - 1 == 1 ? "" : "s") en esta franja
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </section>
</div>

<div class="modal fade ur-modal" id="modalClase" tabindex="-1" aria-labelledby="tituloClase" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 520px;">
        <div class="modal-content">
            <div class="modal-body">
                <div data-vista="franja" hidden>
                    <h2 id="tituloFranja" style="text-align:left"></h2>
                    <p data-franja-resumen style="text-align:left;margin-bottom:1rem"></p>
                    <ul class="ur-franja-lista" data-franja-lista></ul>
                    <div class="ur-modal__botones"><button type="button" class="ur-btn ur-btn--ghost" data-bs-dismiss="modal">Cerrar</button></div>
                </div>
                <div data-vista="detalle" hidden>
                    <button type="button" class="ur-volver" data-volver hidden>
                        <svg class="ur-icon"><use href="#i-arrow-left" /></svg> <span data-volver-texto></span>
                    </button>
                    <h2 id="tituloClase" style="text-align:left" data-det-nombre></h2>
                    <p style="text-align:left;margin:0" data-det-codigo></p>
                    <dl class="ur-det">
                        <div><dt>Horario</dt><dd data-det-horario></dd></div>
                        <div><dt>Salón</dt><dd data-det-salon></dd></div>
                        <div><dt>Créditos</dt><dd data-det-creditos></dd></div>
                        <div><dt>Cupos</dt><dd data-det-cupos></dd></div>
                        <div><dt>Programa</dt><dd data-det-programa></dd></div>
                        <div><dt>Profesor</dt><dd data-det-profesor></dd></div>
                    </dl>
                    <div class="ur-modal__botones">
                        <button type="button" class="ur-btn ur-btn--ghost" data-bs-dismiss="modal">Cerrar</button>
                        <a class="ur-btn ur-btn--primary" data-det-enlace href="#">Ver asignatura completa</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>window.OFERTA_CLASES = @Html.Raw(Json.Serialize(Model.Clases));</script>
    <script src="~/js/oferta.js" asp-append-version="true"></script>
}
