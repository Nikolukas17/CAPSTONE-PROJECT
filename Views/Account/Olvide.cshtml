@model OfertaAcademica.Web.ViewModels.Account.OlvideViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_LayoutAuth";
    var enviado = ViewData["Enviado"] is true;
}

<h1>Olvidé mi contraseña</h1>
<p class="ur-sub">Escribe tu correo institucional y te enviaremos el enlace para crear una nueva.</p>

@if (enviado)
{
    <div class="ur-alert ur-alert--ok" role="status">Enviamos el enlace a @Model.Correo. Revisa tu bandeja de entrada y la carpeta de spam.</div>
}

<form asp-action="Olvide" method="post">
    <div class="ur-field">
        <label asp-for="Correo"></label>
        <input asp-for="Correo" class="ur-input" type="email" placeholder="nombre@urosario.edu.co" autocomplete="username" />
        <span asp-validation-for="Correo" class="ur-error"></span>
    </div>
    <button type="submit" class="ur-btn ur-btn--primary ur-btn--block">Enviar enlace</button>
</form>
<p class="ur-auth__pie"><a asp-action="Login">Volver a iniciar sesión</a></p>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
