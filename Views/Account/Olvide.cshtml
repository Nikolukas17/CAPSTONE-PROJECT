@model OfertaAcademica.Web.ViewModels.Account.OlvideViewModel
@{
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
    ViewData["Title"] = "Olvidé mi contraseña";
}
<div class="auth">
    <aside class="auth__foto"><img src="~/img/logo-rosario-blanco.svg" alt="Universidad del Rosario" /></aside>
    <section class="auth__panel">
        <form class="auth__card" asp-action="Olvide" method="post" novalidate>
            <h1>Olvidé mi contraseña</h1>
            <p class="auth__sub">Escribe tu correo institucional y te enviaremos un enlace para crear una nueva contraseña.</p>

            @if (ViewBag.Enviado == true)
            {
                <div class="alerta" role="status">Listo, te enviamos el enlace a tu correo.</div>
            }

            <div class="campo">
                <label asp-for="Correo"></label>
                <input asp-for="Correo" type="Correo" placeholder="nombre@urosario.edu.co" autocomplete="username" />
                <span asp-validation-for="Correo" class="campo__error"></span>
            </div>

            <button type="submit" class="btn btn--primario auth__enviar">Enviar</button>
            <p class="auth__nota">Revisa tu bandeja de entrada o la carpeta de spam.</p>
            <p class="auth__pie"><a asp-action="Login">Volver a iniciar sesión</a></p>
        </form>
    </section>
</div>

