@using OfertaAcademica.Web.ViewModels.Account
@model PerfilViewModel
@{
    ViewData["Title"] = "Mi cuenta";
}

<section class="card cuenta" aria-labelledby="cuenta-nombre">
    <div class="cuenta__foto">
        @if (!string.IsNullOrEmpty(Model.FotoUrl))
        {
            <img src="@Model.FotoUrl" alt="Foto de @Model.Nombre" />
        }
        else
        {
            <i class="bi bi-person" aria-hidden="true"></i>
        }
    </div>

    <div class="cuenta__datos">
        <h1 id="cuenta-nombre">@Model.Nombre</h1>
        <p><strong>Teléfono:</strong> @Model.Telefono</p>
        <p><strong>Correo:</strong> <a href="mailto:@Model.Correo">@Model.Correo</a></p>
        <p><strong>Cargo:</strong> <span class="cuenta__cargo">@Model.Cargo</span></p>
    </div>

    <form asp-controller="Account" asp-action="CerrarSesion" method="post" class="cuenta__salir-form">
        <button type="submit" class="cuenta__salir">
            <span class="cuenta__salir-ico"><i class="bi bi-box-arrow-left" aria-hidden="true"></i></span>
            Cerrar Sesión
        </button>
    </form>
</section>
