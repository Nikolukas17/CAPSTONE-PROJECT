@model OfertaAcademica.Web.ViewModels.Account.LoginViewModel
@{
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
    ViewData["Title"] = "Iniciar sesión";
}
<div class="auth">
    <aside class="auth__foto"><img src="~/img/logo-rosario-blanco.svg" alt="Universidad del Rosario" /></aside>
    <section class="auth__panel">
        <form class="auth__card" asp-action="Login" method="post" novalidate>
            <h1>Bienvenido</h1>
            <p class="auth__sub">El Sistema de Gestión Académica<br />Escuela de Ciencias e Ingeniería</p>

            <div asp-validation-summary="ModelOnly" class="alerta"></div>

            <div class="campo">
                <label asp-for="Correo"></label>
                <input asp-for="Correo" type="Correo" placeholder="nombre@urosario.edu.co" autocomplete="username" />
                <span asp-validation-for="Correo" class="campo__error"></span>
            </div>
            <div class="campo">
                <label asp-for="Contrasena"></label>
                <div class="campo__pass">
                    <input asp-for="Contrasena" placeholder="••••••••••••" autocomplete="current-password" />
                    <button type="button" class="campo__ojo" data-toggle-pass="Contrasena" aria-label="Mostrar contraseña"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z"/><circle cx="12" cy="12" r="3"/></svg></button>
                </div>
                <span asp-validation-for="Contrasena" class="campo__error"></span>
            </div>
            <div class="auth__fila"><a asp-action="Olvide">¿Olvidaste tu contraseña?</a></div>

            <button type="submit" class="btn btn--primario auth__enviar">Iniciar sesión</button>
            <p class="auth__pie">¿No tienes cuenta? <a asp-action="Registro">Regístrate</a></p>
        </form>
    </section>
</div>

