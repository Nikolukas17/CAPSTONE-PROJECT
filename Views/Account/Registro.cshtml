@model OfertaAcademica.Web.ViewModels.Account.RegistroViewModel
@{
    ViewData["Title"] = "Crear cuenta";
    Layout = "_LayoutAuth";
}

<h1>Regístrate</h1>
<p class="ur-sub">Al Sistema de Gestión Académica de la Escuela de Ciencias e Ingeniería</p>

<form asp-action="Registro" method="post">
    <div class="ur-field">
        <label asp-for="NombreCompleto"></label>
        <input asp-for="NombreCompleto" class="ur-input" placeholder="Ana Pérez" autocomplete="name" />
        <span asp-validation-for="NombreCompleto" class="ur-error"></span>
    </div>
    <div class="ur-field">
        <label asp-for="Cargo"></label>
        <input asp-for="Cargo" class="ur-input" placeholder="Auxiliar académica" autocomplete="organization-title" />
        <span asp-validation-for="Cargo" class="ur-error"></span>
    </div>
    <div class="ur-field">
        <label asp-for="Correo"></label>
        <input asp-for="Correo" class="ur-input" type="email" placeholder="nombre@urosario.edu.co" autocomplete="username" />
        <span asp-validation-for="Correo" class="ur-error"></span>
    </div>
    <div class="ur-field">
        <label asp-for="Contrasena"></label>
        <div class="ur-pass">
            <input asp-for="Contrasena" class="ur-input" autocomplete="new-password" />
            <button type="button" data-ver-clave aria-label="Mostrar contraseña"><svg class="ur-icon"><use href="#i-eye" /></svg></button>
        </div>
        <span asp-validation-for="Contrasena" class="ur-error"></span>
        <span class="ur-hint">Mínimo 8 caracteres.</span>
    </div>
    <button type="submit" class="ur-btn ur-btn--primary ur-btn--block">Crear cuenta</button>
</form>
<p class="ur-auth__pie">¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a></p>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
