@{
    ViewData["Title"] = "Sistema de Gestión de Horarios";
    Layout = "_LayoutPublico";
}

<section class="ur-hero">
    <div class="ur-hero__txt">
        <h1 class="ur-h1">Generando una oferta académica más eficiente</h1>
        <p>Proyecto de Capstone que apoya la creación de la oferta académica de la Escuela de Ciencias e Ingeniería, integrando asignaturas, profesores, estudiantes y salones para facilitar la planeación de cada semestre.</p>
        <div class="ur-hero__cta">
            <a asp-controller="Account" asp-action="Login" class="ur-btn ur-btn--primary">Iniciar sesión</a>
            <a asp-controller="Account" asp-action="Registro" class="ur-btn ur-btn--ghost">Crear cuenta</a>
        </div>
    </div>
    <div class="ur-hero__arte" role="img" aria-label="Arcos del claustro de la Universidad del Rosario">
        <p>Horarios sin cruces, hechos para la comunidad rosarista.</p>
    </div>
</section>

<partial name="_ComoFunciona" />
